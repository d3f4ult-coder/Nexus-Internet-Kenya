{
  "name": "Customer Data Sync Workflow",
  "description": "Syncs customer data from HubSpot to Salesforce with error handling",
  "nodes": [
    {
      "id": "node_1",
      "name": "HubSpot Webhook Trigger",
      "type": "webhook",
      "parameters": {
        "authentication": "apiKey",
        "secret": "***",
        "method": "POST"
      }
    },
    {
      "id": "node_2",
      "name": "Parse Customer Data",
      "type": "function",
      "parameters": {
        "timeout": 5000
      }
    },
    {
      "id": "node_3",
      "name": "Validate Email Format",
      "type": "conditional",
      "parameters": {
        "requestTimeout": 3000
      }
    },
    {
      "id": "node_4",
      "name": "Salesforce Create Contact",
      "type": "http",
      "parameters": {
        "timeout": 10000,
        "retryStrategy": "exponential"
      }
    },
    {
      "id": "node_5",
      "name": "Error Handler - Dead Letter Queue",
      "type": "errorHandler",
      "parameters": {
        "queue": "dlq-customer-sync"
      }
    }
  ],
  "edges": [
    {
      "from": "node_1",
      "to": "node_2"
    },
    {
      "from": "node_2",
      "to": "node_3"
    },
    {
      "from": "node_3",
      "to": "node_4"
    },
    {
      "from": "node_4",
      "to": "node_5"
    }
  ]
}
